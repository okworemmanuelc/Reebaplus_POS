<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31). `allowBackup="false"` stops cloud backup but does NOT
  stop device-to-device transfer, so both sections are declared explicitly and
  both exclude everything (#285).

  The Drift database is a till's local source of truth and is restored without
  the secure-storage session that scopes it, so a transferred copy can land on
  a phone signed in to a different business.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
